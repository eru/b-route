#!/bin/bash

if [ -n "${MUNIN_LIBDIR:-}" ] && [ -f "$MUNIN_LIBDIR/plugins/plugin.sh" ]; then
  . "$MUNIN_LIBDIR/plugins/plugin.sh"
fi

if [ "$1" = "autoconf" ]; then
  echo yes
  exit 0
fi

if [ "$1" = "config" ]; then

  echo 'graph_title B route wattage'
  echo 'graph_args --base 1000 -l 0'
  echo 'graph_vlabel Wattage'
  echo 'graph_info B route wattage'

  echo 'graph_scale no'
  echo 'graph_category sensors'

  echo 'b_route.label B route'
  echo 'b_route.info B route'

  # Last, if run with the "config"-parameter, quit here (don't
  # display any data)
  exit 0
fi

STATUS_FILE="${status_file:-/run/b-route/wattage.json}"
MAX_AGE="${max_age:-300}"

VALUE=$(python3 - "$STATUS_FILE" "$MAX_AGE" <<'EOF'
import json
import sys
import time

status_file = sys.argv[1]
max_age = float(sys.argv[2])

try:
    with open(status_file, "r", encoding="utf-8") as f:
        data = json.load(f)
    updated_at = float(data["updated_at"])
    wattage = int(data["wattage"])
    if time.time() - updated_at > max_age:
        print("U")
    else:
        print(wattage)
except Exception:
    print("U")
EOF
)

echo "b_route.value $VALUE"
